{
  "name": "herdr-task-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Shared local task orchestrator MCP for Codex and Claude running in Herdr",
  "bin": { "herdr-task-mcp": "./dist/src/cli.js" },
  "engines": { "node": ">=22.16.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
